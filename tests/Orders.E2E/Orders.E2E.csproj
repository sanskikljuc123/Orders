<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Reqnroll.xUnit" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Aspire.Hosting.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Reqnroll" />
    <Using Include="Microsoft.Playwright" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Orders.AppHost\Orders.AppHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Random test order with a printed seed (tests/TestSupport/RandomTestOrder.cs): scenarios
         and features run in a new order each run, so Stability also varies the E2E order. -->
    <Compile Include="..\TestSupport\RandomTestOrder.cs" Link="TestSupport\RandomTestOrder.cs" />
    <Content Include="..\TestSupport\xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
