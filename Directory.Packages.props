<Project>
  <!--
    CENTRAL PACKAGE MANAGEMENT: the ONLY place where NuGet versions live.
    .csproj files use <PackageReference Include="X" /> WITHOUT a Version.

    Only versions the project owner explicitly chose are pinned below.
    Everything in the TODO list must be added with `dotnet add package`,
    then its resolved version moved here and verified (`dotnet restore` + `dotnet build`).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Chosen by project owner">
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="13.6.4-preview.1.26523.11" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.4" />
    <PackageVersion Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
    <PackageVersion Include="FakeItEasy" Version="9.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="Reqnroll.xUnit" Version="3.3.4" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.5.0" />
    <PackageVersion Include="Autofac" Version="9.3.1" />
    <PackageVersion Include="FluentValidation" Version="12.1.0" />
  </ItemGroup>
  <!--
    TODO (verify each on NuGet, pin here, keep compatible with the rest):
      Microsoft.Playwright            (browser install must match this version in CI)
      Reqnroll.xUnit                  (must support xunit 2.9.x)
      Reqnroll.Autofac                (Autofac integration, if used)
      FakeItEasy
      Testcontainers, Testcontainers.Keycloak
      Aspire.Hosting.*, Aspire.Hosting.Testing, Aspire.Hosting.Keycloak
      Serilog, Serilog.AspNetCore, Serilog sinks
      Autofac.Extensions.DependencyInjection
      Microsoft.NET.Test.Sdk, xunit.runner.visualstudio
      Nuke.Common, GitVersion.Tool
  -->
</Project>